  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "실패한 작업",
      "description": "큐 작업 중 3번 시도해도 처리하지 못해 따로 모아 둔 것(q.dead). 자동으로 다시 처리하지 않는다 — 1건이라도 있으면 RabbitMQ 관리 화면(http://localhost:15672 → Queues → q.dead → Get messages)에서 내용을 본다. 입력 오류 같은 업무 실패는 여기 쌓이지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "deskless-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "deskless-prometheus"
          },
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=\"q.dead\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:건",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "없음",
                  "index": 0
                }
              }
            }
