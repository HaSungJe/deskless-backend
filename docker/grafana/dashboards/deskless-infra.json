    {
      "id": 8,
      "type": "timeseries",
      "title": "서버별 밀린 작업",
      "description": "쓰기 요청(예약 · 결제 확인 등)이 서버별 큐에서 차례를 기다리는 수. 잠깐 솟았다 바로 0 으로 내려오면 정상, 줄지 않고 계속 늘면 그 서버가 모자라다. 게이트웨이 응답 큐는 바로 비워져 넣지 않았다.",
      "datasource": {
        "type": "prometheus",
        "uid": "deskless-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "deskless-prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(sum by (queue) (rabbitmq_detailed_queue_messages_ready{queue=~\"q.user.cmd|q.admin.cmd\"}), \"queue_name\", \"$1\", \"queue\", \"(.*)\"), \"queue_name\", \"이용자 서버 작업\", \"queue\", \"q\\\\.user\\\\.cmd\"), \"queue_name\", \"관리자 서버 작업\", \"queue\", \"q\\\\.admin\\\\.cmd\"), \"queue_name\", \"실패한 작업\", \"queue\", \"q\\\\.dead\")",
          "legendFormat": "{{queue_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
