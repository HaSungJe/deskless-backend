# 서버 설정 — 로컬 실행(npm run start:*)이 이 값을 그대로 쓴다. 쿠버네티스 배포는 deskless 저장소가 같은 키 이름으로 넣는다
# 키마다의 뜻은 docs/architecture.md 의 "설정"
# (필수) 가 붙은 값이 비어 있으면 앱이 제대로 돌지 않는다
#
# ⚠ 로컬 실행용 기본값이 들어 있다 — cp .env.example .env 만으로 로컬 실행이 된다(AWS 없이 · 테스트 데이터 포함).
#   PostgreSQL · RabbitMQ · Redis 는 deskless 저장소의 로컬 클러스터가 이 PC(localhost)에 열어 준 주소로 붙는다.
#   서버(운영)에 올릴 때는 반드시 바꾼다:
#   - (필수) 비밀값 전부 새로 만든다 — INTERNAL_API_TOKEN · RABBITMQ_*_PASSWORD · DATABASE_URL · REDIS_URL 의 비밀번호 · JWT_SECRET · BCRYPT_CODE · TOKEN_CIPHER_KEY
#   - SEED_SAMPLE_DATA=0(테스트 데이터를 넣지 않는다)
#   - 주소를 실제 값으로 — CORS_ORIGINS · GATEWAY_PUBLIC_URL · USER_WEB_URL

# ── 실행 환경 ───────────────────────────────
# production: 운영 / development: 로컬 디버깅 전용 (JWT 만료를 검사하지 않음)
NODE_ENV=production

# ── 게이트웨이 ──────────────────────────────
# 게이트웨이가 여는 포트
GATEWAY_PORT=3000
# 허용할 프론트 주소 (쉼표 구분, * = 전체, 비우면 모두 차단)
CORS_ORIGINS=http://localhost:5000
# 앞단 프록시 수 — 비우면 사용 안 함(로컬 직접 실행). 쿠버네티스 Ingress 1단이면 1, 그 앞에 클라우드 로드밸런서가 더 있으면 2
TRUST_PROXY=
# 큐 경로 SSE 대기 시간(ms) — 넘기면 pending
COMMAND_STREAM_TIMEOUT_MS=30000
# 인스턴스 ID — 비우면 자동(호스트 이름 — 쿠버네티스는 파드 이름)
GATEWAY_INSTANCE_ID=
SWAGGER_TITLE=Deskless API
SWAGGER_PATH=swagger

# ── 게이트웨이 → user-service · admin-service ─
# 로컬 실행용 주소 (쿠버네티스는 deskless 차트가 Service 주소로 넣는다)
USER_SERVICE_URL=http://localhost:3010
ADMIN_SERVICE_URL=http://localhost:3020
# (필수) 내부 요청 비밀값 — 게이트웨이와 서비스들이 같은 값을 쓴다
INTERNAL_API_TOKEN=local-internal-token-change-me
INTERNAL_HTTP_TIMEOUT_MS=10000

# ── user-service ────────────────────────────
USER_SERVICE_PORT=3010
# 바인딩 주소 — 로컬은 127.0.0.1 (쿠버네티스 파드는 deskless 차트가 0.0.0.0)
USER_SERVICE_HOST=127.0.0.1
# 같은 휴대폰 번호로 하루(한국 날짜)에 보낼 수 있는 인증 SMS 수 — 비우면 10 (user-service · admin-service 공통)
SMS_VERIFICATION_DAILY_LIMIT=10

# ── admin-service (매니저 · 관리자) ─────────
ADMIN_SERVICE_PORT=3020
# 바인딩 주소 — 로컬은 127.0.0.1 (쿠버네티스 파드는 deskless 차트가 0.0.0.0)
ADMIN_SERVICE_HOST=127.0.0.1

# ── PostgreSQL ──────────────────────────────
# (필수) 앱이 접속할 DB — 로컬은 deskless 로컬 클러스터의 PostgreSQL, 운영은 클러스터 안 DB 또는 RDS 등의 주소. 게이트웨이도 쓴다(API 로그 적재 — 로그 전용 연결 풀 5)
DATABASE_URL=postgresql://deskless:deskless@localhost:5432/deskless?schema=public
DATABASE_POOL_SIZE=10
# 풀에서 DB 연결을 기다리는 최대 시간(ms) — 넘기면 그 요청은 500(큐 경로는 재시도). 비우면 30000
DATABASE_CONNECTION_TIMEOUT_MS=30000

# ── RabbitMQ ────────────────────────────────
# (필수) 앱이 접속할 브로커 — 로컬은 deskless 로컬 클러스터의 RabbitMQ, 운영은 클러스터 안 브로커 또는 Amazon MQ 등의 주소
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# 관리자 계정 — npm run broker:check(계정 권한 점검) 전용. 앱은 쓰지 않는다
RABBITMQ_USER=deskless
RABBITMQ_PASSWORD=deskless
# (필수) 앱별 브로커 계정 비밀번호 — 큰따옴표 · 역슬래시 금지. 계정 · 권한은 deskless 인프라 묶음이 만든다(같은 값을 써야 한다)
RABBITMQ_GATEWAY_PASSWORD=local-gateway-pw
RABBITMQ_USER_SERVICE_PASSWORD=local-user-service-pw
RABBITMQ_ADMIN_SERVICE_PASSWORD=local-admin-service-pw

# ── Redis (문 정보) ─────────────────────────
# 호실의 현재 QR · 문을 마지막으로 연 시각 + 바로 열기 명령 채널. 세팅 · 확인 방법: docs/guides/redis-setup.md
# (필수) 앱(gateway · user-service · admin-service · scheduler)이 접속할 Redis — 로컬은 deskless 로컬 클러스터의 Redis, 운영은 클러스터 안 Redis 또는 ElastiCache 등의 주소(TLS 면 rediss://)
# 비밀번호에 @ : / 가 있으면 URL 인코딩한다
REDIS_URL=redis://:deskless@localhost:6379

# ── 인증 · 암호화 ───────────────────────────
# (필수)
JWT_SECRET=local-jwt-secret-change-me
# 비밀번호 해시 pepper — 가입이 시작된 뒤 바꾸면 기존 비밀번호를 검증할 수 없다
BCRYPT_CODE=local-bcrypt-pepper
# 비밀번호 해시 라운드 — 반드시 4~31 사이 정수 (기본 12)
BCRYPT_ROUNDS=12
# (필수) refresh_token 암호화 키, hex 64자
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_CIPHER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── AWS (SMS · 파일 저장) ───────────────────
# 세팅 방법: docs/guides/aws-setup.md — 비워 두면 AWS 없이 돈다(개발 · 포트폴리오, "AWS 없이 돌리기" 절):
#   - AWS_ACCESS_KEY_ID · AWS_SECRET_ACCESS_KEY 가 비면 SMS 를 보내지 않고 받는 번호 · 본문을 서버 로그에 남긴다(인증번호 · 임시 비밀번호는 로그에서 본다)
#   - AWS_S3_BUCKET 이 비면 파일은 내부 파일 저장소(게이트웨이 /files — 폴더 FILE_STORAGE_DIR)에 올리고 내준다
# SMS 는 user-service · admin-service · scheduler, 파일은 user-service · admin-service(+ 게이트웨이 /files)가 쓴다
AWS_REGION=ap-northeast-2
# IAM 사용자 액세스 키 — 비우면 SMS 는 로그로만 남는다(IAM 역할만으로 돌려도 SMS 는 생략된다 — 보내려면 키를 넣는다. S3 는 역할로도 된다)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 사진 버킷 — 비우면 내부 파일 저장소
AWS_S3_BUCKET=
# 공개 파일 주소의 기준 — CloudFront 배포 주소 https://<배포>.cloudfront.net (S3 를 쓸 때 — docs/guides/aws-setup.md). 비어 있으면 공개 파일 주소 요청이 실패한다
AWS_S3_PUBLIC_URL=
# 내부 파일 저장소 폴더(AWS_S3_BUCKET 이 빌 때) — 비우면 storage/files(실행 위치 기준 — 로컬은 저장소 루트). gateway · user-service · admin-service 가 같은 폴더를 봐야 한다.
# 쿠버네티스는 deskless 차트가 공용 파일 볼륨 자리로 넣는다
FILE_STORAGE_DIR=

# ── 게이트웨이 공개 주소 ─────────────────────
# 브라우저가 게이트웨이에 닿는 주소(끝의 / 는 떼고 쓴다. 예: http://localhost:3000) — 내부 파일 저장소의 업로드 · 열람 · 사진 주소(<주소>/files/…)와
# 테스트 데이터 사진 주소(<주소>/sample/…)의 기준. user-service · admin-service 가 쓴다. 비어 있으면 그 주소를 만드는 요청이 실패한다
GATEWAY_PUBLIC_URL=http://localhost:3000

# ── 테스트 데이터 (샘플 시드) ───────────────
# 세팅 방법: docs/guides/sample-data.md — 1 이면 user-service 가 부팅할 때 업체 10곳 · 객실 · 업체 총관리자 10명 · 이용자 1명을 넣는다(고정 ID — 이미 있으면 건너뜀).
# 로컬 기본 1 — 운영 DB 에서는 0
SEED_SAMPLE_DATA=1

# ── 이용자 화면 (SMS 링크) ──────────────────
# 이용자 프론트(Next.js) 주소 — SMS 링크의 기준(끝의 / 는 떼고 쓴다). scheduler 의 QR 확인 링크(<주소>/reservation/<예약 ID>)와
# admin-service 의 이용 중 취소 요청 승인 링크(<주소>/reservation/<예약 ID>/cancel-request)에 쓴다. 비어 있으면 QR 링크는 보내지 않고 이용 중 취소 요청은 503
USER_WEB_URL=http://localhost:5000

# ── 토스페이먼츠 (결제 확인 · 환불) ─────────
# 세팅 방법: docs/guides/toss-setup.md — 결제창 · 승인은 프론트(Next.js), 서버는 토스 조회로 검증 · 환불(user-service 예약 · scheduler 결제 대기 만료 · 환불 crontab)
# 시크릿 키 — 개발은 테스트 키(test_sk_…), 운영은 라이브 키(live_sk_…). 비어 있으면 부팅은 되고 예약 생성 · 결제 확인 · 환불만 실패한다(503)
TOSS_SECRET_KEY=

# ── 지표 · 헬스 체크 포트 ───────────────────
# 앱마다 /metrics(지표) · /health/live · /health/ready(쿠버네티스 프로브)를 여는 전용 포트 — docs/monitoring.md
# 로컬에서 네 앱이 한 PC 에서 돌 때 겹치지 않게 앱마다 다르다. 쿠버네티스는 deskless 차트가 9464 로 넣는다
GATEWAY_METRICS_PORT=9464
USER_SERVICE_METRICS_PORT=9465
ADMIN_SERVICE_METRICS_PORT=9466
SCHEDULER_METRICS_PORT=9467
# 바인딩 주소 — 로컬 127.0.0.1, 쿠버네티스는 deskless 차트가 0.0.0.0(프로브 · 지표 수집만 닿는다)
METRICS_HOST=127.0.0.1
