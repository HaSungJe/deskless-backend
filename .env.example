# 서버 설정 — 로컬 실행(npm run start:*)이 그대로 쓰고, 쿠버네티스는 deskless 가 같은 키 이름으로 넣는다. 키마다의 뜻은 docs/architecture.md "설정"
# 로컬 기본값이라 cp .env.example .env 만으로 뜬다(AWS 없이 · 테스트 데이터 포함 — DB · 브로커 · Redis 는 deskless 로컬 클러스터의 localhost)
# 운영: (필수) 비밀값은 모두 새로 · SEED_SAMPLE_DATA=0 · 주소(CORS_ORIGINS · GATEWAY_PUBLIC_URL · USER_WEB_URL)는 실제 값

# ── 공통 ────────────────────────────────────
# production: 운영 / development: 로컬 디버깅(JWT 만료를 검사하지 않는다)
NODE_ENV=production
# (필수) 게이트웨이 ↔ 서비스 내부 요청 비밀값 — 모든 앱이 같은 값
INTERNAL_API_TOKEN=local-internal-token-change-me
# 지표 · 헬스 체크 바인딩 — 로컬 127.0.0.1(쿠버네티스는 deskless 차트가 0.0.0.0). 앱별 포트는 각 앱 절
METRICS_HOST=127.0.0.1

# ── gateway ─────────────────────────────────
# 포트 · 지표 · 헬스 체크 포트
GATEWAY_PORT=3000
GATEWAY_METRICS_PORT=9464
# 브라우저가 게이트웨이에 닿는 주소(끝 / 없이) — 내부 파일 저장소 · 테스트 데이터 사진 주소의 기준(user-service · admin-service 도 쓴다)
GATEWAY_PUBLIC_URL=http://localhost:3000
# 허용할 프론트 주소(쉼표 구분, * = 전체, 비우면 모두 차단)
CORS_ORIGINS=http://localhost:5000
# 앞단 프록시 단 수 — 비우면 쓰지 않는다(로컬 직접 실행)
TRUST_PROXY=
# 큐 경로 SSE 대기(ms — 넘기면 pending) · 서비스 내부 HTTP 대기(ms)
COMMAND_STREAM_TIMEOUT_MS=30000
INTERNAL_HTTP_TIMEOUT_MS=10000
# 인스턴스 ID — 비우면 호스트 이름(쿠버네티스는 파드 이름)
GATEWAY_INSTANCE_ID=
SWAGGER_TITLE=Deskless API
SWAGGER_PATH=swagger
# 서비스 주소 — 로컬용(쿠버네티스는 deskless 차트가 Service 주소로)
USER_SERVICE_URL=http://localhost:3010
ADMIN_SERVICE_URL=http://localhost:3020

# ── user-service ────────────────────────────
# 포트 · 바인딩(로컬 127.0.0.1) · 지표 · 헬스 체크 포트
USER_SERVICE_PORT=3010
USER_SERVICE_HOST=127.0.0.1
USER_SERVICE_METRICS_PORT=9465
# 테스트 데이터 — 1 이면 부팅 때 업체 · 객실 · 계정을 넣는다(운영 0) — docs/guides/sample-data.md
SEED_SAMPLE_DATA=1

# ── admin-service ───────────────────────────
# 포트 · 바인딩(로컬 127.0.0.1) · 지표 · 헬스 체크 포트
ADMIN_SERVICE_PORT=3020
ADMIN_SERVICE_HOST=127.0.0.1
ADMIN_SERVICE_METRICS_PORT=9466

# ── scheduler ───────────────────────────────
# 지표 · 헬스 체크 포트(들어오는 연결은 이것뿐)
SCHEDULER_METRICS_PORT=9467

# ── PostgreSQL ──────────────────────────────
# (필수) 접속 주소 — 네 앱 모두(게이트웨이는 API 로그만)
DATABASE_URL=postgresql://deskless:deskless@localhost:5432/deskless?schema=public
# 풀 크기 · 연결 대기 최대(ms — 넘기면 500)
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=30000

# ── RabbitMQ ────────────────────────────────
# (필수) 브로커 주소
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# 관리자 계정 — npm run broker:check 전용(앱은 쓰지 않는다)
RABBITMQ_USER=deskless
RABBITMQ_PASSWORD=deskless
# (필수) 앱별 계정 비밀번호 — deskless 인프라 묶음과 같은 값, 큰따옴표 · 역슬래시 금지
RABBITMQ_GATEWAY_PASSWORD=local-gateway-pw
RABBITMQ_USER_SERVICE_PASSWORD=local-user-service-pw
RABBITMQ_ADMIN_SERVICE_PASSWORD=local-admin-service-pw

# ── Redis (문 정보) ─────────────────────────
# (필수) 접속 주소 — 비밀번호의 @ : / 는 URL 인코딩, TLS 면 rediss:// — docs/guides/redis-setup.md
REDIS_URL=redis://:deskless@localhost:6379

# ── 로그인 · 암호화 ─────────────────────────
# (필수) 토큰 서명 비밀값
JWT_SECRET=local-jwt-secret-change-me
# 비밀번호 해시 pepper(가입이 시작된 뒤 바꾸지 않는다) · 라운드(4 ~ 31, 기본 12)
BCRYPT_CODE=local-bcrypt-pepper
BCRYPT_ROUNDS=12
# (필수) refresh 토큰 암호화 키 hex 64자 — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_CIPHER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── AWS 공통 ────────────────────────────────
# 키가 비면 AWS 없이 돈다(SMS 는 로그로만) — docs/guides/aws-setup.md
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── SMS ─────────────────────────────────────
# 같은 휴대폰 번호의 하루 인증 SMS 수(비우면 10)
SMS_VERIFICATION_DAILY_LIMIT=10
# SMS 링크의 이용자 웹 주소(끝 / 없이) — 비면 QR 확인 링크를 보내지 않고 이용 중 취소 요청은 503
USER_WEB_URL=http://localhost:5000

# ── 파일 저장 ───────────────────────────────
# 사진 버킷(비우면 내부 파일 저장소) · CDN 주소(S3 를 쓸 때 필요) — docs/guides/aws-setup.md
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
# 내부 파일 저장소 폴더 — 비우면 storage/files(쿠버네티스는 deskless 차트)
FILE_STORAGE_DIR=

# ── 결제 (토스페이먼츠) ─────────────────────
# 시크릿 키(test_sk_ · live_sk_) — 비면 예약 생성 · 결제 확인 · 환불만 503 — docs/guides/toss-setup.md
TOSS_SECRET_KEY=
